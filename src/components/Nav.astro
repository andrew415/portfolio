---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/experience", label: "Experience" },
  { href: "/projects", label: "Projects" },
];
---

<nav>
  <a href="/" class="logo">AD</a>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} class={path === link.href ? "active" : ""}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    max-width: 1080px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  .logo {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 26px;
  }

  .active {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>
