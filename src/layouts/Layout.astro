<style is:global>
  :root {
    --bg: #efecdd;
    --text: #121212;
    --muted: #5a5a57;
    --line: #dad8d1;
    --accent: #0e6e5c;
    --font: "Plus Jakarta Sans", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 17px;
    line-height: 1.65;
  }

  h1,
  h2,
  h3 {
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  a {
    color: var(--accent);
    font-weight: 500;
  }
</style>
