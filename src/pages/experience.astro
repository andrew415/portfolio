---
import Layout from "../layouts/Layout.astro";

const statement = [
  "I co-founded Kopi Deo in Jakarta",
  "and grew it from an idea",
  "into a restaurant with 40 employees.",
  "Along the way, I learned that great products",
  "start with listening",
  "to the people who use them.",
];

const stats = [
  { to: 40, prefix: "", suffix: "", label: "employees across kitchen, service, cashier, and support" },
  { to: 10, prefix: "+", suffix: "%", label: "rainy-season revenue after redesigning the dining area" },
  { to: 5, prefix: "", suffix: "+", label: "years running, from concept to daily operations" },
];

const education = [
  {
    logo: "/asu-logo.png",
    logoAlt: "Arizona State University logo",
    degree: "B.A. Applied Business and Technology Solutions",
    school: "Arizona State University",
    date: "August 2026 – May 2028",
    coursework: "Business Statistics, Microeconomic Principles, Computer Applications and Information Technology",
    organizations: "",
  },
  {
    logo: "dvc-logo.png",
    logoAlt: "Diablo Valley College logo",
    degree: "Computer Science",
    school: "Diablo Valley College",
    date: "January 2023 – May 2025",
    coursework: "Object-Oriented Programming in C++, Data Structures, Calculus, Linear Algebra, Intro to Data Science",
    organizations: "Code the Change, Google Developer Student Club, Model United Nations, Math Club, Soccer Club, Earth Club",
  },
];

const campus = [
  {
    org: "DVC Earth Club",
    role: "Director of Technology",
    date: "Nov 2025 – Dec 2025",
    summary: "Ran the club's online community across Instagram and Discord.",
    bullets: [
      "Managed the club's Instagram, creating posts to promote meetings, events, and sustainability initiatives.",
      "Set up and moderated the club's Discord server to keep members connected and informed between meetings.",
    ],
  },
  {
    org: "DVC Model United Nations",
    role: "Vice President of Operations",
    date: "Jan 2024 – May 2025",
    summary: "Kept the club running smoothly and prepared members for Model United Nations conferences.",
    bullets: [
      "Organized club meetings, prepared members for conferences, and coordinated responsibilities and prep timelines each semester.",
      "Kept officers and members connected, so everyone knew about deadlines and upcoming events.",
    ],
  },
  {
    org: "DVC Soccer Club",
    role: "Secretary",
    date: "Aug 2023 – Aug 2024",
    summary: "Kept the club organized and helped plan its biggest event of the year.",
    bullets: [
      "Recorded meeting notes and tracked action items so officers stayed aligned on decisions.",
      "Helped set the club's goals for the year with the officer team.",
      "Helped plan an 8-team tournament, from scheduling to day-of coordination.",
    ],
  },
  {
    org: "DVC Math Club",
    role: "Chief Strategy Officer",
    date: "Aug 2023 – May 2024",
    summary: "Ran competition prep and events for a club of 20–30 regular members.",
    bullets: [
      "Led competition prep that supported DVC's 1st-place finish in AMATYC Round 1.",
      "Organized Data Science and Math in Business workshops, plus a guest talk from a data scientist.",
      "Ran a Jeopardy-style math game that drew the club's highest turnout of the semester.",
    ],
  },
  {
    org: "Code the Change",
    role: "Project Leader",
    date: "Aug 2023 – Dec 2023",
    summary:
      "Co-led a student team building a website for The Little House, a nonprofit running 4 schools for 200+ children in Indonesia.",
    bullets: [
      "Led an 8-member team from project planning through website delivery.",
      "Designed the Home, About, History, Gallery, and Donate pages in Figma.",
      "Ran weekly check-ins, broke features into tasks, and shared resources to help teammates build skills.",
    ],
  },
  {
    org: "Google Developer Student Club",
    role: "Developer (UI/UX Design)",
    date: "Oct 2023 – Dec 2023",
    summary: "Designed Freedom Wall, a message board where students post and reply after signing in with Google.",
    bullets: [
      "Designed 4 core pages in Figma, from Google sign-in to a student's first post.",
      "Mapped user flows and screen states for posting and replying.",
      "Worked with 3 developers to build it as a responsive Next.js app.",
    ],
  },
];
---

<Layout>
  <main class="page experience">
    <section class="page-intro intro-center">
      <h1>Experience</h1>
      <p>Where I've worked, led, and learned.</p>
      <p class="scroll-hint">Scroll ↓</p>
    </section>

    <!-- WORK EXPERIENCE -->
    <section>
      <p class="section-label">Work Experience</p>
      <h2 class="role-title">Co-Founder & Operations Manager</h2>
      <p class="org">Kopi Deo · Jakarta, Indonesia</p>
      <p class="date">September 2021 – Present</p>

      <div class="highlight-zone" id="highlight">
        <div class="highlight-sticky">
          <p class="highlight-text">
            {statement.map((line) => <span>{line} </span>)}
          </p>
        </div>
      </div>

      <div class="stats" id="stats">
        {
          stats.map((stat) => (
            <div>
              <p class="num" data-to={stat.to} data-prefix={stat.prefix} data-suffix={stat.suffix}>
                {stat.prefix}0{stat.suffix}
              </p>
              <p class="stat-label">{stat.label}</p>
            </div>
          ))
        }
      </div>

      <ul class="details">
        <li>Used customer feedback to find gaps in the menu and launch new appetizers, increasing average revenue per customer.</li>
        <li>Lead hiring, onboarding, payroll, inventory, and cash controls to keep service quality and finances on track.</li>
        <li>Added a high roof and clear rain blinds so every outdoor table stays open in wet weather.</li>
      </ul>
    </section>

    <!-- EDUCATION -->
    <section>
      <p class="section-label">Education</p>
      <div class="edu" id="edu">
        <div class="edu-track"></div>
        <div class="edu-fill" id="edu-fill"></div>
        {
          education.map((item) => (
            <div class="edu-item">
              {item.logo && <img class="logo" src={item.logo} alt={item.logoAlt} />}
              <h3>{item.degree}</h3>
              <p class="org">{item.school}</p>
              <p class="date">{item.date}</p>
              <p class="detail">
                <strong>Relevant coursework:</strong> {item.coursework}
              </p>
              {item.organizations && (
                <p class="detail">
                  <strong>Organizations:</strong> {item.organizations}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- CAMPUS INVOLVEMENT -->
    <section>
      <p class="section-label">Campus Involvement</p>
      <div class="tabs">
        <div class="tablist" role="tablist" aria-label="Campus involvement">
          {
            campus.map((item, i) => (
              <button
                role="tab"
                id={`tab-${i}`}
                aria-controls={`panel-${i}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? "0" : "-1"}
              >
                {item.org}
              </button>
            ))
          }
        </div>

        <div class="panels">
          {
            campus.map((item, i) => (
              <div role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
                <h3>{item.role}</h3>
                <p class="org">{item.org}</p>
                <p class="date">{item.date}</p>
                <p class="summary">{item.summary}</p>
                <ul>
                  {item.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  function clamp(value: number) {
    return Math.max(0, Math.min(1, value));
  }

  // Text highlight + education timeline
  const zone = document.getElementById("highlight")!;
  const spans = Array.from(zone.querySelectorAll("span"));
  const edu = document.getElementById("edu")!;
  const eduFill = document.getElementById("edu-fill")!;
  const eduItems = Array.from(edu.querySelectorAll<HTMLElement>(".edu-item"));

  function onScroll() {
    const vh = innerHeight;

    const z = zone.getBoundingClientRect();
    const progress = reduceMotion ? 1 : clamp((vh * 0.7 - z.top) / (z.height - vh * 0.5));
    spans.forEach((span, i) => span.classList.toggle("on", progress > i / spans.length));

    const e = edu.getBoundingClientRect();
    const filled = Math.max(0, Math.min(e.height - 12, vh * 0.6 - e.top));
    eduFill.style.height = `${filled}px`;
    eduItems.forEach((item) => item.classList.toggle("lit", item.offsetTop <= filled));
  }

  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  onScroll();

  // Impact counters
  const statsBox = document.getElementById("stats")!;
  const numbers = Array.from(statsBox.querySelectorAll<HTMLElement>(".num"));

  function runCounters() {
    numbers.forEach((el) => {
      const to = Number(el.dataset.to);
      const prefix = el.dataset.prefix ?? "";
      const suffix = el.dataset.suffix ?? "";
      const duration = reduceMotion ? 0 : 1400;
      const start = performance.now();

      function tick(now: number) {
        const t = duration ? Math.min((now - start) / duration, 1) : 1;
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = `${prefix}${Math.round(to * eased)}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  }

  const statsObserver = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        runCounters();
        statsObserver.disconnect();
      }
    },
    { threshold: 0.4 }
  );
  statsObserver.observe(statsBox);

  // Campus involvement tabs
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

  function selectTab(index: number) {
    tabs.forEach((tab, i) => {
      const active = i === index;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      panels[i].hidden = !active;
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => selectTab(i));
    tab.addEventListener("keydown", (event) => {
      let next = -1;
      if (event.key === "ArrowDown" || event.key === "ArrowRight") next = (i + 1) % tabs.length;
      if (event.key === "ArrowUp" || event.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
      if (next >= 0) {
        event.preventDefault();
        selectTab(next);
        tabs[next].focus();
      }
    });
  });
</script>

<style>
  .experience {
    max-width: 960px;
  }

  section + section {
    padding-bottom: 96px;
  }

  .section-label {
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 48px;
    border-top: 1px solid var(--line);
    margin: 0 0 32px;
  }

  .role-title {
    font-size: clamp(32px, 5vw, 48px);
    margin: 0 0 8px;
  }

  .org {
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  .date {
    color: var(--muted);
    font-size: 14px;
    margin: 2px 0 0;
  }

  /* Text highlight */
  .highlight-zone {
    height: 200vh;
  }

  .highlight-sticky {
    position: sticky;
    top: 25vh;
    padding: 24px 0;
  }

  .highlight-text {
    font-family: var(--font-head);
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.15;
    margin: 0;
  }

  .highlight-text span {
    color: #c9c6bd;
    transition: color 0.3s ease;
  }

  .highlight-text span.on {
    color: var(--text);
  }

  /* Counters */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    margin: 0 0 48px;
  }

  .num {
    font-family: var(--font-head);
    font-size: clamp(56px, 8vw, 80px);
    line-height: 1;
    color: var(--accent);
    margin: 0;
  }

  .stat-label {
    color: var(--muted);
    margin: 10px 0 0;
  }

  .details {
    padding-left: 20px;
    max-width: 680px;
  }

  .details li {
    margin: 8px 0;
  }

  /* Education timeline */
  .edu {
    position: relative;
    padding-left: 44px;
  }

  .edu-track,
  .edu-fill {
    position: absolute;
    left: 9px;
    top: 12px;
    width: 2px;
  }

  .edu-track {
    bottom: 0;
    background: var(--line);
  }

  .edu-fill {
    height: 0;
    background: var(--accent);
  }

  .edu-item {
    position: relative;
    padding-bottom: 64px;
  }

  .edu-item:last-child {
    padding-bottom: 0;
  }

  .edu-item::before {
    content: "";
    position: absolute;
    left: -44px;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    transition: border-color 0.3s ease;
  }

  .edu-item.lit::before {
    border-color: var(--accent);
  }

  .logo {
    display: block;
    height: 64px;
    width: auto;
    margin-bottom: 20px;
  }

  .edu-item h3 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 10px;
  }

  .detail {
    color: var(--muted);
    max-width: 640px;
    margin: 16px 0 0;
  }

  .detail strong {
    color: var(--text);
    font-weight: 500;
  }

  /* Tabs */
  .tabs {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    align-items: start;
  }

  .tablist {
    display: flex;
    flex-direction: column;
    border-left: 2px solid var(--line);
  }

  .tablist button {
    font: inherit;
    text-align: left;
    background: none;
    border: none;
    border-left: 2px solid transparent;
    margin-left: -2px;
    padding: 12px 16px;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .tablist button:hover {
    color: var(--text);
  }

  .tablist button[aria-selected="true"] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  .tablist button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  [role="tabpanel"] h3 {
    font-size: clamp(30px, 4vw, 40px);
    margin: 0 0 6px;
  }

  .summary {
    margin: 16px 0 0;
  }

  [role="tabpanel"] ul {
    padding-left: 20px;
    margin: 12px 0 0;
  }

  [role="tabpanel"] li {
    margin: 6px 0;
  }

  @media (max-width: 760px) {
    .tabs {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .tablist {
      flex-direction: row;
      overflow-x: auto;
      border-left: none;
      border-bottom: 2px solid var(--line);
    }

    .tablist button {
      white-space: nowrap;
      border-left: none;
      border-bottom: 2px solid transparent;
      margin: 0 0 -2px;
    }

    .tablist button[aria-selected="true"] {
      border-bottom-color: var(--accent);
    }
  }
</style>