---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="hero">
    <div class="intro">
      <p class="eyebrow">Business + Tech · ASU '28</p>
      <h1>Andrew Damanik</h1>
      <p class="lead">
        Junior at Arizona State University studying Applied Business and
        Technology Solutions, interested in product management and AI/ML.
      </p>

      <div class="now">
        <h2>Currently</h2>
        <ul>
          <li>Co-Founder at Kopi Deo</li>
          <li>B.A. Applied Business & Technology Solutions at ASU</li>
        </ul>
      </div>

      <p class="contact">
        <a href="mailto:andrewhasintongan@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/andrew-damanik">LinkedIn</a>
        <a href="https://github.com/andrew415">GitHub</a>
      </p>
    </div>

    <div class="gallery">
      <div class="track" id="track">
        <img src="/me-1.JPG" alt="Me at Time Square" />
        <img src="/me-2.JPG" alt="My first big show" />
        <img src="/me-3.JPG" alt="DJing at Golden Gate Bridge" />
        <img src="/me-4.JPG" alt="Golfing with the homies" />
        <img src="/me-5.JPG" alt="Me playing padel" />
      </div>
      <div class="dots" id="dots"></div>
    </div>
  </main>
</Layout>

<script>
  const track = document.getElementById("track")!;
  const dotsBox = document.getElementById("dots")!;
  const slides = track.querySelectorAll("img");

  slides.forEach((_, i) => {
    const dot = document.createElement("button");
    dot.setAttribute("aria-label", `Show photo ${i + 1}`);
    dot.addEventListener("click", () => {
      track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" });
    });
    dotsBox.appendChild(dot);
  });

  const dots = dotsBox.querySelectorAll("button");

  function update() {
    const index = Math.round(track.scrollLeft / track.clientWidth);
    dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
  }

  track.addEventListener("scroll", update);
  update();
</script>

<style>
  .hero {
    max-width: 1080px;
    margin: 0 auto;
    padding: 64px 24px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
    min-height: calc(100vh - 160px);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(44px, 7vw, 72px);
    margin: 0 0 16px;
  }

  .lead {
    font-size: 19px;
    color: var(--muted);
    margin: 0 0 32px;
  }

  .now h2 {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 8px;
  }

  .now ul {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }

  .now li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }

  .contact {
    display: flex;
    gap: 20px;
    margin: 0;
  }

  .gallery {
    width: 100%;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 4px;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track img {
    flex: 0 0 100%;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    scroll-snap-align: start;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
  }

  .dots :global(button) {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--line);
    cursor: pointer;
  }

  .dots :global(button.active) {
    background: var(--accent);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      min-height: auto;
    }
    .gallery {
      order: -1;
      max-width: 360px;
    }
  }
</style>
